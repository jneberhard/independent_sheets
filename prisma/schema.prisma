generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum RoleName {
  USER
  PUBLISHER
  ADMIN
}

enum CategoryGroup {
  VOICING
  INSTRUMENT
  GENRE
}

model Role {
  id    String   @id @default(cuid())
  name  RoleName @unique
  users User[]
}

model User {
  id        String  @id @default(cuid())
  email     String  @unique
  firstName String?
  lastName  String?
  name      String?

  authProvider String  @default("credentials")
  passwordHash String?

  roleId String
  role   Role   @relation(fields: [roleId], references: [id])

  addressLine1  String?
  addressLine2  String?
  city          String?
  stateProvince String?
  postalCode    String?
  country       String?
  phoneNumber   String?

  publisher Publisher?

  sheetMusic SheetMusic[] @relation("UserSheetMusic")
  purchases  Purchase[]   @relation("UserPurchases")
  contracts  Contract[]   @relation("UserContracts")
  reviews    Reviews[]

  createdAt DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model SheetMusic {
  id             String   @id @default(cuid())
  title          String
  description    String?
  priceCents     Int
  pdfUrl         String
  imageUrl       String?
  previewMp3Url  String?
  previewLink    String?
  rightsVerified Boolean  @default(false)

  artistId String
  artist   User   @relation("UserSheetMusic", fields: [artistId], references: [id])

  categories SheetMusicCategory[]
  purchases  Purchase[]
  reviews    Reviews[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Purchase {
  id           String   @id @default(cuid())
  buyerId      String
  sheetMusicId String
  amountCents  Int
  purchasedAt  DateTime @default(now())

  buyer      User       @relation("UserPurchases", fields: [buyerId], references: [id])
  sheetMusic SheetMusic @relation(fields: [sheetMusicId], references: [id])

  royalty Royalty?
}

model Royalty {
  id             String   @id @default(cuid())
  purchaseId     String   @unique
  artistAmount   Int
  platformAmount Int
  createdAt      DateTime @default(now())
  purchase       Purchase @relation(fields: [purchaseId], references: [id])
}

model Contract {
  id             String    @id @default(cuid())
  artistId       String
  royaltyPercent Float
  startDate      DateTime
  endDate        DateTime?
  createdAt      DateTime  @default(now())

  artist User @relation("UserContracts", fields: [artistId], references: [id])
}

model Publisher {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id])

  firstName   String
  lastName    String
  displayName String

  addressLine1  String
  addressLine2  String?
  city          String
  stateProvince String
  postalCode    String
  country       String
  phoneNumber   String?

  biography         String?
  websiteUrl        String?
  youtubeUrl        String?
  spotifyUrl        String?
  primaryCategories String?
  primaryVoicings   String?

  uploadingOriginalWorks Boolean
  uploadingArrangements  Boolean
  ownsOrControlsRights   Boolean
  acceptedAgreement      Boolean

  paypalEmail            String?
  preferredPaymentMethod String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Category {
  id        String        @id @default(cuid())
  name      String
  slug      String
  group     CategoryGroup
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  sheetMusicCategories SheetMusicCategory[]

  @@unique([group, slug])
}

model SheetMusicCategory {
  id           String @id @default(cuid())
  sheetMusicId String
  categoryId   String

  sheetMusic SheetMusic @relation(fields: [sheetMusicId], references: [id])
  category   Category   @relation(fields: [categoryId], references: [id])

  @@unique([sheetMusicId, categoryId])
}

model Reviews {
  id           String @id @default(cuid())
  reviewText   String
  rating       Int
  userId       String
  sheetMusicId String

  sheetMusic SheetMusic @relation(fields: [sheetMusicId], references: [id])
  user       User       @relation(fields: [userId], references: [id])
}
