generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum RoleName {
  CUSTOMER
  ARTIST
  ADMIN
}

model Role {
  id    String   @id @default(cuid())
  name  RoleName @unique
  users User[]
}

model User {
  id         String      @id @default(cuid())
  email      String      @unique
  name       String?
  roleId     String
  role       Role        @relation(fields: [roleId], references: [id])
  sheetMusic SheetMusic[]
  purchases  Purchase[]
  contracts  Contract[]
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
}

model SheetMusic {
  id            String      @id @default(cuid())
  title         String
  description   String?
  priceCents    Int
  pdfUrl        String
  previewMp3Url String?
  previewLink   String?
  artistId      String
  artist        User        @relation(fields: [artistId], references: [id])
  purchases     Purchase[]
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
}

model Purchase {
  id           String     @id @default(cuid())
  buyerId      String
  sheetMusicId String
  amountCents  Int
  purchasedAt  DateTime   @default(now())
  buyer        User       @relation(fields: [buyerId], references: [id])
  sheetMusic   SheetMusic @relation(fields: [sheetMusicId], references: [id])
  royalty      Royalty?
}

model Royalty {
  id             String   @id @default(cuid())
  purchaseId     String   @unique
  artistAmount   Int
  platformAmount Int
  createdAt      DateTime @default(now())
  purchase       Purchase @relation(fields: [purchaseId], references: [id])
}

model Contract {
  id             String   @id @default(cuid())
  artistId       String
  royaltyPercent Float
  startDate      DateTime
  endDate        DateTime?
  createdAt      DateTime @default(now())
  artist         User     @relation(fields: [artistId], references: [id])
}